---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedNews, displayDate, fiscalYear } from '../../lib';

export async function getStaticPaths() {
  const posts = await getPublishedNews();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
---
<BaseLayout title={post.data.title}>
  <article class="post">
    <p class="meta">
      <time datetime={post.data.date.toISOString()}>{displayDate(post)}</time>
      <span>{fiscalYear(post)}年度</span>
      {post.data.author && <span>{post.data.author}</span>}
    </p>
    <h1>{post.data.title}</h1>
    {post.data.tags.length > 0 && (
      <ul class="tags">
        {post.data.tags.map((tag) => (
          <li><a href={`/news/tags/${encodeURIComponent(tag)}/`}>{tag}</a></li>
        ))}
      </ul>
    )}
    <div class="post-body"><Content /></div>
  </article>
  <p><a href="/news/">NEWS 一覧へ</a></p>
</BaseLayout>
