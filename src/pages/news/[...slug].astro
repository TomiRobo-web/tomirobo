---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedNews, displayDate, fiscalYear } from '../../lib';

export async function getStaticPaths() {
  const posts = await getPublishedNews();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
---
<BaseLayout title={post.data.title}>
  <article>
    <p class="tr-meta">
      <span class="tr-date">{displayDate(post)}</span>
      <span>{fiscalYear(post)}年度</span>
      {post.data.author && <span>{post.data.author}</span>}
    </p>
    <h1 class="tr-heading tr-heading--page"><span class="tr-heading__ja">{post.data.title}</span></h1>
    {post.data.tags.length > 0 && (
      <ul class="tr-tags">
        {post.data.tags.map((tag) => (
          <li><a class="tr-tag" href={`/news/tags/${encodeURIComponent(tag)}/`}>{tag}</a></li>
        ))}
      </ul>
    )}
    <div class="tr-prose tr-section"><Content /></div>
  </article>
  <p class="tr-actions"><a class="tr-button" href="/news/">NEWS 一覧へ <span class="tr-button__arrow">→</span></a></p>
</BaseLayout>
