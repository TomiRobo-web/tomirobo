---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedNews, displayDate, fiscalYear } from '../../lib';

export async function getStaticPaths() {
  const posts = await getPublishedNews();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);

/** 記事本文の Markdown から記号・画像・URL を除き、先頭の約120文字を説明文にする */
function excerpt(markdown: string, max = 120): string {
  const text = markdown
    .replace(/```[\s\S]*?```/g, ' ') // コードブロック
    .replace(/<!--[\s\S]*?-->/g, ' ')
    .replace(/!\[[^\]]*\]\([^)]*\)/g, ' ') // 画像
    .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1') // リンクは文字だけ残す
    .replace(/<\/?[a-z][^>]*>/gi, ' ') // HTML タグと <URL>
    .replace(/https?:\/\/[\w\-./?%&=#:~+@!,;]+/g, ' ')
    .replace(/^\s*(?:#{1,6}\s+|>\s?|[-*+]\s+|\d+\.\s+)/gm, '') // 見出し・引用・箇条書きの記号
    .replace(/^\s*[-*_|:\s]{3,}$/gm, ' ') // 区切り線・表の罫線
    .replace(/\\[ \t]*$/gm, '') // 行末の \ は改行
    .replace(/\*\*|~~|`/g, '')
    .replace(/\\([!-\/:-@\[-`{-~])/g, '$1') // \* などのエスケープ
    .replace(/\s+/g, ' ')
    .replace(/([、。，．！？」）]) /g, '$1')
    .trim();
  const chars = [...text];
  return chars.length > max ? `${chars.slice(0, max).join('').trimEnd()}…` : text;
}
const description = excerpt(post.body ?? '') || `${post.data.title}｜TomiRobo 活動報告`;
---
<BaseLayout title={post.data.title} description={description} ogType="article">
  <article>
    <p class="tr-meta">
      <span class="tr-date">{displayDate(post)}</span>
      <span>{fiscalYear(post)}年度</span>
      {post.data.author && <span>{post.data.author}</span>}
    </p>
    <h1 class="tr-heading tr-heading--page"><span class="tr-heading__ja">{post.data.title}</span></h1>
    {post.data.tags.length > 0 && (
      <ul class="tr-tags">
        {post.data.tags.map((tag) => (
          <li><a class="tr-tag" href={`/news/tags/${encodeURIComponent(tag)}/`}>{tag}</a></li>
        ))}
      </ul>
    )}
    <div class="tr-prose tr-section"><Content /></div>
  </article>
  <p class="tr-actions"><a class="tr-button" href="/news/">NEWS 一覧へ <span class="tr-button__arrow">→</span></a></p>
</BaseLayout>
