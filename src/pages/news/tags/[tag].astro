---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import NewsList from '../../../components/NewsList.astro';
import TagFilter from '../../../components/TagFilter.astro';
import { getPublishedNews, collectTags } from '../../../lib';

export async function getStaticPaths() {
  const posts = await getPublishedNews();
  return collectTags(posts).map((tag) => ({
    params: { tag },
    props: { tag, allTags: collectTags(posts), posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}
const { tag, allTags, posts } = Astro.props;
---
<BaseLayout title={`NEWS: ${tag}`}>
  <h1>NEWS <small>活動報告</small></h1>
  <TagFilter tags={allTags} current={tag} />
  <NewsList posts={posts} groupByYear />
</BaseLayout>
