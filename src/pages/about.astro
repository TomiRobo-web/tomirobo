---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeading from '../components/PageHeading.astro';
import Gear from '../components/Gear.astro';
import page from '../data/pages/about.json';
// 本文は旧 Google Sites の Project ページから移行（2026-11-15）
---
<BaseLayout title="ABOUT">
  <PageHeading en={page.heading.en} ja={page.heading.ja} />

  <section class="tr-section tr-text">
    <h2 class="tr-heading"><span class="tr-heading__en">{page.history.en}</span><span class="tr-heading__ja">{page.history.ja}</span></h2>
    <img class="tr-float-logo" src={page.history.logo.src} alt={page.history.logo.alt} width={page.history.logo.width} height={page.history.logo.height} />
    {page.history.paragraphs.map((paragraph) => (
      <p>{paragraph}</p>
    ))}
    <p>{page.history.recordsLink.before}<a href={page.history.recordsLink.href}>{page.history.recordsLink.linkText}</a>{page.history.recordsLink.after}</p>
  </section>

  <section class="tr-section">
    <h2 class="tr-heading"><span class="tr-heading__en">{page.teams.en}</span><span class="tr-heading__ja">{page.teams.ja}</span></h2>
    <p>{page.teams.intro}</p>
    <div class="tr-grid">
      {page.teams.items.map((team) => (
        <div class="tr-frame">
          <Gear class="tr-frame__gear" />
          <span class="tr-frame__label">{team.en}</span>
          <h3 class="tr-frame__title">{team.ja}</h3>
          <p class="tr-frame__text">{team.text}</p>
        </div>
      ))}
    </div>
  </section>

  <p class="tr-actions"><a class="tr-button tr-button--primary" href={page.joinAction.href}>{page.joinAction.label} <span class="tr-button__arrow">→</span></a></p>
</BaseLayout>
