---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeading from '../components/PageHeading.astro';
import page from '../data/pages/join.json';
// 本文は旧 Google Sites の Project・Contact ページの募集案内から移行（2026-11-15）
---
<BaseLayout title="JOIN">
  <PageHeading en={page.heading.en} ja={page.heading.ja} />
  <p class="tr-lead">{page.lead}</p>
  <div class="tr-text">
    {page.paragraphs.map((paragraph) => (
      <p>{paragraph}</p>
    ))}
  </div>
  <p class="tr-actions"><a class="tr-button tr-button--primary" href={page.contactAction.href}>{page.contactAction.label} <span class="tr-button__arrow">→</span></a></p>

  <img class="tr-figure" src={page.poster.src} alt={page.poster.alt} width={page.poster.width} height={page.poster.height} loading="lazy" />

  <section class="tr-section tr-text">
    <h2 class="tr-heading"><span class="tr-heading__en">{page.activitySection.en}</span><span class="tr-heading__ja">{page.activitySection.ja}</span></h2>
    <p>{page.activitySection.before}<a href={page.activitySection.aboutHref}>{page.activitySection.aboutLabel}</a>{page.activitySection.middle}<a href={page.activitySection.newsHref}>{page.activitySection.newsLabel}</a>{page.activitySection.after}</p>

    <h2 class="tr-heading"><span class="tr-heading__en">{page.contactSection.en}</span><span class="tr-heading__ja">{page.contactSection.ja}</span></h2>
    <p><a href={page.contactSection.href}>{page.contactSection.linkLabel}</a>{page.contactSection.after}</p>
  </section>
</BaseLayout>
