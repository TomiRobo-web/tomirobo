---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeading from '../components/PageHeading.astro';
import page from '../data/pages/contact.json';
// 本文は旧 Google Sites の Contact ページから移行（2026-11-15）
---
<BaseLayout title="CONTACT">
  <PageHeading en={page.heading.en} ja={page.heading.ja} />

  <section class="tr-section tr-text">
    <h2 class="tr-heading"><span class="tr-heading__en">{page.linksSection.en}</span><span class="tr-heading__ja">{page.linksSection.ja}</span></h2>
    <ul class="tr-contacts">
      {page.links.map((l) => (
        <li>
          <h3><a href={l.href}>{l.name}</a></h3>
          <p>{l.note}<br />（{l.label}）</p>
        </li>
      ))}
    </ul>
    <p>{page.recruitNote}</p>
  </section>

  <section class="tr-section tr-text">
    <h2 class="tr-heading"><span class="tr-heading__en">{page.accessSection.en}</span><span class="tr-heading__ja">{page.accessSection.ja}</span></h2>
    <address class="tr-address">
      {page.addressLines.map((line, i) => (<>{i > 0 && <br />}{line}</>))}
    </address>
    <img class="tr-figure" src={page.campusMap.src} alt={page.campusMap.alt} width={page.campusMap.width} height={page.campusMap.height} loading="lazy" />
    <iframe
      class="tr-map"
      title={page.googleMap.title}
      src={page.googleMap.embedUrl}
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"></iframe>
  </section>
</BaseLayout>
