---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeading from '../components/PageHeading.astro';
import page from '../data/pages/sponsor.json';
// 本文は旧 Google Sites の Sponsor ページから移行（2026-11-15）。掲載順は旧サイトと同じ（五十音順）
---
<BaseLayout title="SPONSOR">
  <PageHeading en={page.heading.en} ja={page.heading.ja} />
  <p class="tr-lead">{page.lead}</p>

  <ul class="tr-logos">
    {page.sponsors.map((s) => (
      <li>
        <img src={s.logo} alt={`${s.name.replace(/ 様$/, '')} のロゴ`} loading="lazy" />
        <p>{s.name}</p>
      </li>
    ))}
  </ul>
  <p>{page.orderNote}</p>

  <section class="tr-section tr-text">
    <h2 class="tr-heading"><span class="tr-heading__en">{page.supportSection.en}</span><span class="tr-heading__ja">{page.supportSection.ja}</span></h2>
    <p>{page.supportSection.before}<a href={page.supportSection.linkHref}>{page.supportSection.linkLabel}</a>{page.supportSection.after}</p>
    <p class="tr-actions"><a class="tr-button tr-button--primary" href={page.supportSection.actionHref}>{page.supportSection.actionLabel} <span class="tr-button__arrow">→</span></a></p>
  </section>
</BaseLayout>
