---
// HOME。骨格は docs/designsystem/guidelines/PAGE_PATTERNS.md
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsList from '../components/NewsList.astro';
import Gear from '../components/Gear.astro';
import { getPublishedNews } from '../lib';
import page from '../data/pages/home.json';
const latest = (await getPublishedNews()).slice(0, 5);
---
<BaseLayout title="HOME" wide onAi>
  <section class="tr-hero">
    <Gear class="tr-hero__gear" />
    <div class="tr-hero__inner">
      <div>
        <span class="tr-hero__label">{page.hero.label}</span>
        <h1 class="tr-hero__copy">{page.hero.copyLines.map((line, i) => (<>{i > 0 && <br />}{line}</>))}</h1>
        <p class="tr-lead">{page.hero.lead}</p>
        <p class="tr-actions">
          <a class="tr-button tr-button--on-ai" href={page.hero.primaryAction.href}>{page.hero.primaryAction.label} <span class="tr-button__arrow">→</span></a>
          <a class="tr-button tr-button--ghost-on-ai" href={page.hero.secondaryAction.href}>{page.hero.secondaryAction.label} <span class="tr-button__arrow">→</span></a>
        </p>
      </div>
      <img class="tr-hero__logo" src={page.hero.logo.src} alt={page.hero.logo.alt} width={page.hero.logo.width} height={page.hero.logo.height} />
    </div>
  </section>

  <div class="tr-container">
    <section class="tr-section">
      <h2 class="tr-heading"><span class="tr-heading__en">{page.newsSection.en}</span><span class="tr-heading__ja">{page.newsSection.ja}</span></h2>
      <NewsList posts={latest} />
      <p class="tr-actions"><a class="tr-button" href={page.newsSection.moreHref}>{page.newsSection.moreLabel} <span class="tr-button__arrow">→</span></a></p>
    </section>

    <section class="tr-section">
      <h2 class="tr-heading"><span class="tr-heading__en">{page.teamsSection.en}</span><span class="tr-heading__ja">{page.teamsSection.ja}</span></h2>
      <div class="tr-grid">
        {page.teamsSection.teams.map((t) => (
          <a class="tr-frame" href={t.href}>
            <Gear class="tr-frame__gear" />
            <span class="tr-frame__label">{t.en}</span>
            <h3 class="tr-frame__title">{t.ja}</h3>
            <p class="tr-frame__text">{t.text}</p>
          </a>
        ))}
      </div>
    </section>
  </div>

  <section class="tr-band tr-band--ai">
    <div class="tr-band__inner">
      <h2 class="tr-heading"><span class="tr-heading__en">{page.band.en}</span><span class="tr-heading__ja">{page.band.ja}</span></h2>
      <p>{page.band.text}</p>
      <p class="tr-actions">
        {page.band.actions.map((action) => (
          <a class="tr-button" href={action.href}>{action.label} <span class="tr-button__arrow">→</span></a>
        ))}
      </p>
    </div>
  </section>
</BaseLayout>
