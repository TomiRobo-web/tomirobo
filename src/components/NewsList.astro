---
// 日付つきの記事一覧（docs/designsystem/components/NewsItem）
import { displayDate, groupByFiscalYear, type News } from '../lib';
interface Props { posts: News[]; groupByYear?: boolean }
const { posts, groupByYear = false } = Astro.props;
const groups = groupByYear ? groupByFiscalYear(posts) : [[0, posts] as [number, News[]]];
---
{posts.length === 0 ? (
  <p>記事はまだありません。</p>
) : (
  groups.map(([fy, items]) => (
    <section class={groupByYear ? 'tr-section' : undefined}>
      {groupByYear && (
        <h2 class="tr-heading tr-heading--rule"><span class="tr-heading__ja">{fy}年度</span></h2>
      )}
      <ul class="tr-news">
        {items.map((post) => (
          <li class="tr-news__item">
            {post.data.date_estimated ? (
              <span class="tr-news__date">{displayDate(post)}</span>
            ) : (
              <time class="tr-news__date" datetime={post.data.date.toISOString().slice(0, 10)}>{displayDate(post)}</time>
            )}
            <a class="tr-news__title" href={`/news/${post.id}/`}>{post.data.title}</a>
            {post.data.tags.length > 0 && (
              <ul class="tr-tags tr-news__meta">
                {post.data.tags.map((tag) => <li><span class="tr-tag">{tag}</span></li>)}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </section>
  ))
)}
