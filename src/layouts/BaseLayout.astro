---
// 全ページ共通の枠。見た目のルールは docs/designsystem/ を参照
import '../styles/tokens.css';
import '../styles/components.css';
import { NAV } from '../components/nav';

interface Props {
  title: string;
  description?: string;
  /** true のとき main を幅いっぱいにする（帯を端まで伸ばすページ用） */
  wide?: boolean;
}
const { title, description = '富山大学ロボコンプロジェクト TomiRobo の公式サイト', wide = false } = Astro.props;
const pageTitle = title === 'HOME' ? 'TomiRobo | 富山大学ロボコンプロジェクト' : `${title} | TomiRobo`;
const current = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/' ? current === '/' : current.startsWith(href.replace(/\/$/, ''));
const menu = NAV.filter((item) => item.href !== '/');
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <!-- 正式公開まで検索エンジンに載せない。公開時にこの行を消す -->
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Noto+Sans+JP:wght@400;500;700;900&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="tr-header">
      <div class="tr-header__inner">
        <a class="tr-header__logo" href="/">
          <img src="/images/pages/tomirobo-logo.png" alt="" width="40" height="40" />TomiRobo
        </a>
        <nav aria-label="メインメニュー">
          <ul class="tr-nav">
            {menu.map((item) => (
              <li>
                <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  <span class="tr-nav__en">{item.en}</span>
                  <span class="tr-nav__ja">{item.ja}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main class:list={['tr-main', { 'tr-container': !wide }]}>
      <slot />
    </main>
    <footer class="tr-footer">
      <div class="tr-container">
        <p>TomiRobo（富山大学ロボコンプロジェクト）<br />富山大学 五福キャンパス 工学部 創造工学センター</p>
        <p><a href="/contact/">お問い合わせ</a></p>
        <p>© 2010 TomiRobo</p>
      </div>
    </footer>
  </body>
</html>
