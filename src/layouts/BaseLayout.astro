---
import '../styles/global.css';
import { NAV } from '../components/nav';

interface Props {
  title: string;
  description?: string;
}
const { title, description = '富山大学ロボコンプロジェクト TomiRobo の公式サイト' } = Astro.props;
const pageTitle = title === 'HOME' ? 'TomiRobo' : `${title} | TomiRobo`;
const current = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/' ? current === '/' : current.startsWith(href.replace(/\/$/, ''));
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <!-- 正式公開まで検索エンジンに載せない。公開時にこの行を消す -->
    <meta name="robots" content="noindex, nofollow" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="logo" href="/">TomiRobo</a>
      <nav aria-label="メインメニュー">
        <ul>
          {NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                <span class="en">{item.en}</span>
                <span class="ja">{item.ja}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>© TomiRobo（富山大学ロボコンプロジェクト）</p>
    </footer>
  </body>
</html>
